DATABASE_URL=postgres://fleetglass_app:fleetglass_app@localhost:5432/fleetglass
DATABASE_URL_MIGRATE=postgres://fleetglass:fleetglass@localhost:5432/fleetglass
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
EMAIL_SERVER=
EMAIL_FROM=Fleetglass <noreply@yourdomain.com>
DEV_MAILBOX=1
ALLOW_PLAN_OVERRIDE=1
# DEV_PLAN_OVERRIDE=active
INTEGRATION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional platform Slack OAuth app. Bot secrets are saved per user in Settings → Integrations.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
CHIEF_HANDOFF_URL=
# GitHub: repos under DollarPe-Infra and avinitDollarpe.
# Mentions: avinitDollarpe, cursor, cursoragent. Idempotency: comment id.
# Without a stored App install, the webhook uses these owner envs.
GITHUB_FLEETGLASS_USER_ID=
GITHUB_OWNER_EMAIL=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
