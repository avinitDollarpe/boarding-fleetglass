DATABASE_URL=postgres://fleetglass_app:fleetglass_app@localhost:5432/fleetglass
DATABASE_URL_MIGRATE=postgres://fleetglass:fleetglass@localhost:5432/fleetglass

# Slack is deploy env only. No OAuth and no settings form.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_MENTION_USER_ID=U08C40K4FHN
SLACK_BOT_USER_ID=

# Base URL for the signed Slack reply callback. No trailing slash.
# If unset, https://$VERCEL_URL is used when Vercel sets that host.
# If both are unset, Slack wakes still run and the brief omits reply.
FLEETGLASS_PUBLIC_URL=
# HMAC key for POST /api/slack/reply.
FLEETGLASS_REPLY_SECRET=

# Richard's Grok Bot webhook routine fleetglass-slack-chief-webhook.
# Panel Webhook URL.
CHIEF_HANDOFF_URL=
# Panel Authorization header, full value (typically `Bearer <key>`). Paste as shown.
CHIEF_HANDOFF_AUTHORIZATION=

# GitHub repos under DollarPe-Infra and avinitDollarpe.
# Mentions: avinitDollarpe, cursor, cursoragent, plus GITHUB_APP_SLUG.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
