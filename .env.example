OWNER_EMAIL=
# Slack is deploy env only. No per-user connector and no OAuth.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_MENTION_USER_ID=U08C40K4FHN
SLACK_BOT_USER_ID=
CHIEF_HANDOFF_URL=
# GitHub: repos under DollarPe-Infra and avinitDollarpe.
# Mentions: avinitDollarpe, cursor, cursoragent. Idempotency: comment id.
# Without a stored App install, the webhook uses these owner envs.
GITHUB_FLEETGLASS_USER_ID=
GITHUB_OWNER_EMAIL=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
